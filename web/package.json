{
  "name": "@kept/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KEPT — the landing page. See ../docs/plans/landing-page.md.",
  "scripts": {
    "tokens": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/generate-tokens.mjs",
    "dev": "npm run tokens && next dev --port 3000",
    "build": "npm run tokens && next build",
    "deck:pdf": "npm run build && node scripts/deck-export.mjs",
    "preview": "npm run build && wrangler pages dev --port 8788",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "audit": "node ./scripts/lighthouse.mjs",
    "deploy": "npm run build && wrangler pages deploy",
    "check:motion": "node ./scripts/check-motion.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "lighthouse": "13.5.0",
    "prettier": "3.9.8",
    "puppeteer-core": "25.11.0",
    "typescript": "5.9.2",
    "wrangler": "4.131.2"
  }
}
