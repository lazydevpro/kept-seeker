{
  "$schema": "node_modules/wrangler/config-schema.json",

  /*
   * Cloudflare Pages, not Workers Assets.
   *
   * Both serve the same static `out/`, but the hostname differs and that is the whole reason
   * for the choice: Workers gives `<worker>.<account-subdomain>.workers.dev`, which for this
   * account is `kept-web.lazydevpro.workers.dev`. Pages gives `<project>.pages.dev` with no
   * account segment.
   *
   * `kept.pages.dev` was the goal and is not available — the subdomain is global across all
   * Cloudflare accounts, and creating a project called `kept` returns `kept-1rq.pages.dev`
   * with a random suffix rather than failing. `getkept` is taken the same way. `keptapp` and
   * `gokept` are both free and both reserved on this account; `keptapp` is the live one and
   * `gokept` is the spare.
   *
   * The `name` here IS the subdomain. Renaming it moves the site.
   */
  "name": "kept-seeker",
  // KEPT for Seeker's own Cloudflare account is pinned in package.json's deploy script
  // (CLOUDFLARE_ACCOUNT_ID): Pages configs refuse "account_id". The "kept-seeker" wrangler
  // profile is bound to this folder as well.
  "compatibility_date": "2026-08-18",
  "pages_build_output_dir": "./out",

  // Per-address send counts for `functions/api/contact.ts`. The id names a namespace, it is
  // not a credential.
  "kv_namespaces": [{ "binding": "CONTACT_LIMITS", "id": "fb5493ccab2a47c3bb2d3c90b046441f" }],
}
