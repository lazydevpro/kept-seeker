{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "EXPO_PUBLIC_SOLANA_CLUSTER=mainnet-beta npx expo start --web --port 8098 --clear"
      ],
      "cwd": "mobile",
      "port": 8098
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "web",
      "port": 3000
    },
    {
      "name": "api-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--port", "8787"],
      "cwd": "backend",
      "port": 8787
    }
  ]
}
