{
  "name": "@neon-reserve/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run types && npm run typecheck && npm run format:check && npm test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed.sql",
    "db:seed:demo": "node ./scripts/seed-demo.mjs",
    "db:seed:circle": "node ./scripts/seed-demo.mjs --circle-only",
    "deploy": "node ./scripts/deploy-guard.mjs",
    "deploy:staging": "npm run check && wrangler d1 migrations apply DB --env staging --remote && wrangler deploy --env staging",
    "deploy:production": "npm run check && wrangler d1 migrations apply DB --env production --remote && wrangler deploy --env production",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@better-auth/expo": "1.7.4",
    "@noble/curves": "2.4.0",
    "@solana-program/memo": "^0.11.0",
    "@solana/kit": "^6.1.0",
    "better-auth": "1.7.4",
    "bs58": "6.0.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@types/node": "24.7.2",
    "drizzle-kit": "0.31.10",
    "prettier": "3.9.8",
    "typescript": "5.9.2",
    "vitest": "4.1.0",
    "wrangler": "4.131.2"
  }
}
