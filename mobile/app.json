{
  "expo": {
    "name": "KEPT",
    "slug": "kept-seeker",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keptseeker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": ["applinks:kept-seeker.pages.dev", "applinks:kept-seeker-web.keptseeker.workers.dev"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBFBF4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lazydevpro.keptseeker",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kept-seeker.pages.dev",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "kept-seeker-web.keptseeker.workers.dev",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 64,
          "resizeMode": "contain",
          "backgroundColor": "#FBFBF4",
          "dark": {
            "backgroundColor": "#0C0F0A"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {}
    },
    "owner": "lazydevpro"
  }
}
