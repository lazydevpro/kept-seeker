{
  "name": "mobile",
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "release:apk": "./scripts/release-apk.sh",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run android:build",
    "dev": "expo start --clear --dev-client --reset-cache",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "start": "expo start",
    "web": "expo start --web",
    "deploy:web": "expo export --platform web --output-dir dist && wrangler deploy",
    "preview:web": "expo export --platform web --output-dir dist && wrangler dev",
    "release:key": "./scripts/new-release-key.sh"
  },
  "displayName": "KEPT",
  "description": "KEPT — promises compound. A private social investing habit app for Solana Mobile.",
  "usecase": "Mobile",
  "keywords": [
    "expo",
    "mobile-wallet-adapter",
    "react-native",
    "solana-kit"
  ],
  "main": "./index.js",
  "version": "1.0.0",
  "dependencies": {
    "@better-auth/expo": "1.7.4",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.0.3",
    "@neon-reserve/widget": "file:./modules/neon-widget",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@shopify/react-native-skia": "2.4.18",
    "@solana-program/memo": "^0.11.0",
    "@solana/kit": "^6.1.0",
    "@tanstack/react-query": "^5.90.7",
    "@wallet-ui/react-native-kit": "^4.0.1",
    "better-auth": "1.7.4",
    "expo": "~55.0.23",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.18",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image": "~55.0.6",
    "expo-linking": "~55.0.8",
    "expo-network": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.7",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.10",
    "expo-web-browser": "~55.0.10",
    "js-base64": "^3.7.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-quick-crypto": "^0.7.17",
    "react-native-reanimated": "4.2.1",
